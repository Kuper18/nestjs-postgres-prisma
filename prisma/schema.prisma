generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  firstName String @map("first_name")
  lastName  String @map("last_name")

  @@map("users")
}
